[Desktop Entry]
Name=Ghostgram Desktop
Comment=Desktop version of Ghostgram - Telegram client with Ghost Mode
TryExec=Ghostgram
Exec=env DESKTOPINTEGRATION=1 Ghostgram -- %U
Icon=com.ayugram.desktop
Terminal=false
StartupWMClass=Ghostgram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;ghostgram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Ghostgram -quit
Name=Quit Ghostgram
Icon=application-exit
